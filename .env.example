# ========================================
# WallpaperChanger - Environment Configuration
# ========================================
# Copy this file to .env and fill in your API keys
# Do NOT commit the .env file to version control

# ========================================
# Wallpaper Provider API Keys
# ========================================

# Wallhaven API Key from https://wallhaven.cc/settings/account
# Required for Wallhaven wallpaper provider
WALLHAVEN_API_KEY=your_wallhaven_api_key_here

# Pexels API Key from https://www.pexels.com/api/new/
# Required for Pexels wallpaper provider
PEXELS_API_KEY=your_pexels_api_key_here

# Unsplash API Key from https://unsplash.com/developers
# Optional: Unsplash wallpaper provider
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Pixabay API Key from https://pixabay.com/api/docs/
# Optional: Pixabay wallpaper provider
PIXABAY_API_KEY=your_pixabay_api_key_here

# ========================================
# AI Services API Keys
# ========================================

# Google Gemini API Key from https://makersuite.google.com/app/apikey
# Required for AI-powered features (mood detection, smart recommendations)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key from https://platform.openai.com/api-keys
# Optional: Alternative AI service
OPENAI_API_KEY=your_openai_api_key_here

# ========================================
# Reddit Configuration (No API Key Required)
# ========================================

# Reddit user agent for API requests
REDDIT_USER_AGENT=WallpaperChanger/1.0 (by u/lelus78)

# Default subreddits to fetch wallpapers from
REDDIT_SUBREDDITS=wallpapers,wallpaper,EarthPorn,NatureWallpaper

# Reddit sort method: hot, new, rising, top, controversial
REDDIT_SORT=hot

# Reddit time filter: hour, day, week, month, year, all
REDDIT_TIME_FILTER=day

# Maximum number of wallpapers to fetch from Reddit
REDDIT_LIMIT=60

# ========================================
# Application Settings
# ========================================

# Default wallpaper provider: wallhaven, pexels, reddit, unsplash, pixabay
DEFAULT_PROVIDER=reddit

# Enable provider rotation across wallpaper changes
ENABLE_PROVIDER_ROTATION=true

# Provider rotation sequence (comma-separated)
PROVIDER_SEQUENCE=wallhaven,pexels,reddit

# Pexels search mode: search or curated
PEXELS_MODE=curated

# Pexels search query when using "search" mode
PEXELS_QUERY=nature

# ========================================
# Cache and Performance Settings
# ========================================

# Cache directory location (relative to app directory)
CACHE_DIR=WallpaperChangerCache

# Maximum cache size in MB
MAX_CACHE_SIZE=500

# Cache cleanup interval in hours
CACHE_CLEANUP_INTERVAL=24

# ========================================
# Logging and Debug Settings
# ========================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable debug mode (additional logging and console output)
DEBUG_MODE=false

# Log file location (relative to app directory)
LOG_FILE=wallpaper_changer.log

# ========================================
# Wallpaper Settings
# ========================================

# Default wallpaper change interval in minutes
CHANGE_INTERVAL=30

# Enable automatic wallpaper rotation
AUTO_ROTATE=true

# Download directory for wallpapers (relative to app directory)
DOWNLOAD_DIR=downloads

# Supported image formats (comma-separated)
SUPPORTED_FORMATS=jpg,jpeg,png,bmp,webp

# ========================================
# Weather Integration Settings
# ========================================

# Enable weather-based wallpaper selection
ENABLE_WEATHER_INTEGRATION=false

# OpenWeatherMap API Key from https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Default location for weather (city,country or lat,lon)
DEFAULT_LOCATION=New York,US

# ========================================
# Advanced Settings
# ========================================

# Maximum concurrent downloads
MAX_CONCURRENT_DOWNLOADS=3

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Enable system tray integration
ENABLE_SYSTEM_TRAY=true

# Start minimized to system tray
START_MINIMIZED=false

# Check for updates on startup
CHECK_UPDATES=true
